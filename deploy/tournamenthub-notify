#!/usr/bin/env python3
import json
import os
import sys
import urllib.request
from pathlib import Path

PROJECT = os.environ.get("NOTIFY_PROJECT", "TournamentHub Production")

MESSAGES = {
    "backup-failure": f"🚨 {PROJECT} — échec de la sauvegarde Supabase ! Vérifier : journalctl -u tournamenthub-supabase-backup.service",
    "deploy-success": f"✅ {PROJECT} — nouvelle version déployée avec succès.",
    "deploy-failure": f"🚨 {PROJECT} — échec du déploiement. Vérifier le rollback : journalctl -u tournamenthub-prod-rollout.service",
    "rollback-success": f"⚠️ {PROJECT} — déploiement échoué, ancienne version restaurée avec succès.",
    "rollback-failure": f"🚨 {PROJECT} — échec critique : le rollback n'a pas fonctionné !",
}

if len(sys.argv) != 2 or sys.argv[1] not in MESSAGES:
    sys.exit("Usage: tournamenthub-notify " + "|".join(MESSAGES))

url = Path(os.environ.get("DISCORD_WEBHOOK_URL_FILE", "/home/nolhan/.config/tournamenthub/discord-webhook-url")).read_text().strip()
payload = json.dumps({"content": MESSAGES[sys.argv[1]], "allowed_mentions": {"parse": []}}).encode()
request = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json", "User-Agent": "TournamentHub-Monitor/1.0"}, method="POST")

try:
    with urllib.request.urlopen(request, timeout=15) as response:
        if response.status not in (200, 204):
            raise RuntimeError(f"HTTP {response.status}")
    print("Notification Discord envoyée.")
except Exception as exc:
    print(f"Échec notification Discord : {type(exc).__name__}", file=sys.stderr)
    sys.exit(1)
