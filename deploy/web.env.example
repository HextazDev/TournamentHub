# Copy to a private file, e.g. deploy/web.env (ignored by Git).
# Supply credentials at runtime; never put secrets in Docker build arguments or NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key from the same Supabase project (never expose in NEXT_PUBLIC_*).
SUPABASE_SERVICE_ROLE_KEY=

# Internal server-to-server URL to the bot API (Compose bridge default: http://bot:8080).
BOT_API_URL=http://bot:8080
# Shared server-to-server secret (at least 32 characters; must match BOT_API_SECRET in deploy/bot.env).
BOT_API_SECRET=

# Public HTTPS origin of this web application and random NextAuth secret (>= 32 characters).
NEXTAUTH_URL=https://your-web.example.org
NEXTAUTH_SECRET=

# Discord OAuth application credentials (same application ID as the bot).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
