# Copy to a private file, e.g. deploy/bot.env (ignored by Git).
# Supply credentials at runtime; never put them in Docker build arguments.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random value of at least 32 characters. Same value on the web server.
BOT_API_SECRET=
# Optional separate secret; webhook callers must also send Authorization Bearer BOT_API_SECRET.
WEBHOOK_SECRET=
FRONTEND_URL=https://your-web.example.org
# For command registration only. Use a distinct application/guild for staging.
DISCORD_GUILD_ID=
DISCORD_COMMAND_SCOPE=global

# Integration secrets master key (32 bytes, hex or base64): openssl rand -hex 32. Required.
INTEGRATION_ENCRYPTION_KEY=
